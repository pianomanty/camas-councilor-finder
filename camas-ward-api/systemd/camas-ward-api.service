[Unit]
Description=Camas Ward Lookup Flask API
After=network.target

[Service]
Type=simple
User=strongtowns
Group=strongtowns
WorkingDirectory=/home/strongtowns/camas-councilor-finder/camas-ward-api
ExecStart=/home/strongtowns/camas-councilor-finder/.venv/bin/python app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
